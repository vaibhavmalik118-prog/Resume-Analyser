# Copy this file to .env and add your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional settings
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is out of quota or overloaded
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
# Job-match % needed to be marked "Eligible for shortlisting"
SHORTLIST_THRESHOLD=70
MAX_FILE_MB=10
PORT=8000
